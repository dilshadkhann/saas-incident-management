# ==========================================
# OpsHub - Local Development Environment
# ==========================================

# Application
APP_NAME=OpsHub
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_DB=opshub
POSTGRES_USER=opshub
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection
DATABASE_URL=postgresql+psycopg://opshub:change_this_local_password@localhost:5432/opshub

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=replace_with_a_secure_random_secret
SESSION_COOKIE_SECURE=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# CORS
CORS_ORIGINS=["http://localhost:5173"]